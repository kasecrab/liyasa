{
  "$schema": "https://liyasa.dev/schema/v0/liyasa.json",
  "name": "Acme Docs",
  "description": "Everything you need to build with Acme.",
  "logo": "assets/logo.svg",
  "favicon": "assets/favicon.svg",
  "colors": { "primary": "#4F46E5", "light": "#818CF8", "dark": "#3730A3" },
