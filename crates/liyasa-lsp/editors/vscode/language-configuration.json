{
  "comments": { "blockComment": ["{# ", " #}"] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "{{", "close": " }}" },
    { "open": "{%", "close": " %}" }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["*", "*"], ["_", "_"]],
  "wordPattern": "[A-Za-z0-9_.\\-/]+",
  "onEnterRules": [
    {
      "beforeText": "^\\s*:{3,}[A-Za-z0-9-]+.*$",
      "action": { "indent": "indent" }
    }
  ]
}
