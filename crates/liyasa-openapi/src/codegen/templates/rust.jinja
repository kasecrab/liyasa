use reqwest::Client;

let client = Client::new();
let response = client
    .request(reqwest::Method::{{ req.method }}, {{ req.url | dquote }})
{%- for header in req.headers %}
    .header({{ header.name | dquote }}, {{ header.value | dquote }})
{%- endfor %}
{%- if req.cookieHeader %}
    .header("Cookie", {{ req.cookieHeader | dquote }})
{%- endif %}
{%- if req.body %}
    .body({{ req.body.text | dquote }})
{%- endif %}
    .send()
    .await?;

println!("{}", response.text().await?);
