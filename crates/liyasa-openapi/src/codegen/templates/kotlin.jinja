import okhttp3.OkHttpClient
import okhttp3.Request
{%- if req.body %}
import okhttp3.RequestBody.Companion.toRequestBody
import okhttp3.MediaType.Companion.toMediaType
{%- endif %}

val client = OkHttpClient()

val request = Request.Builder()
    .url({{ req.url | dquote }})
{%- for header in req.headers %}
    .addHeader({{ header.name | dquote }}, {{ header.value | dquote }})
{%- endfor %}
{%- if req.cookieHeader %}
    .addHeader("Cookie", {{ req.cookieHeader | dquote }})
{%- endif %}
{%- if req.body %}
    .method({{ req.method | dquote }}, {{ req.body.text | dquote }}.toRequestBody({{ req.body.mediaType | dquote }}.toMediaType()))
{%- else %}
    .method({{ req.method | dquote }}, null)
{%- endif %}
    .build()

client.newCall(request).execute().use { response ->
    println(response.body?.string())
}
