{
  "$id": "https://liyasa.dev/schema/v1/frontmatter.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Liyasa page front matter",
  "description": "The keys of §7.6 that Liyasa itself reads. Every one is optional; `title`\nfalls back to the first H1 or the file name with a warning.\n\nDates are kept as the author wrote them rather than parsed into a calendar\ntype: the build clock (§6.6.2) is the only time source that reaches output,\nand no date crate is in the dependency table.",
  "type": "object",
  "properties": {
    "access": {
      "anyOf": [
        {
          "$ref": "#/$defs/Access"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ai": {
      "anyOf": [
        {
          "$ref": "#/$defs/AiSetting"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "asyncapi": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "authors": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "canonical": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "draft": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null
    },
    "facts": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "graphql": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "groups": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "hidden": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null
    },
    "icon": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "iconType": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "id": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "keywords": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "locales": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Locale"
      }
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "noindex": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null
    },
    "og": {
      "anyOf": [
        {
          "$ref": "#/$defs/SocialMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "openapi": {
      "description": "`\"spec-id METHOD /path\"`.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "personalized": {
      "description": "Declares that the page reads free-form `reader.*` fields and is rendered\non demand (§6.6.4); without it, `reader.*` is `E0208`.",
      "type": [
        "boolean",
        "null"
      ],
      "default": null
    },
    "product": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "regions": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegionGate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "related": {
      "description": "Page IDs or routes for the related topics block.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "reviewed": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "search": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchSetting"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sidebarTitle": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "slug": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "tag": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "template": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "twitter": {
      "anyOf": [
        {
          "$ref": "#/$defs/SocialMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "updated": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "url": {
      "description": "External URL; the page is a navigation link only and has no body.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "variation": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "verify": {
      "description": "Mirrors the `verify` schema object (§14).",
      "default": null
    },
    "versions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Version"
      }
    }
  },
  "schemaVersion": "1.0",
  "$defs": {
    "Access": {
      "description": "Whether a page on a private site is readable without authentication\n(AUTH-07). Distinct from the site-level `public` flag.",
      "type": "string",
      "enum": [
        "inherit",
        "public"
      ]
    },
    "AiSetting": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "description": "`instructions` are appended to the page's Markdown output.",
          "type": "object",
          "properties": {
            "instructions": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "Locale": {
      "description": "A BCP 47 language tag such as `en` or `pt-BR`.",
      "type": "string"
    },
    "PageId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "PageMode": {
      "description": "Page layout (§7.7).",
      "type": "string",
      "enum": [
        "default",
        "wide",
        "custom",
        "frame",
        "center",
        "assistant"
      ]
    },
    "RegionGate": {
      "type": "object",
      "properties": {
        "except": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "only": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SearchSetting": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "boost": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "exclude": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      ]
    },
    "SocialMeta": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Version": {
      "description": "A documentation version label such as `v2`, not a semver of Liyasa.",
      "type": "string"
    }
  }
}
